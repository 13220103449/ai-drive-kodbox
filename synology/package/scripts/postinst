#!/bin/sh
WEB_ROOT="/var/services/web_packages/aidrive"
VAR_ROOT="${SYNOPKG_PKGVAR:-/var/packages/aidrive/var}"
DATA_ROOT="$VAR_ROOT/data"

mkdir -p "$DATA_ROOT"

if [ -e "$WEB_ROOT/data" ] && [ ! -L "$WEB_ROOT/data" ]; then
    # Do not preserve a previous web-server owner's metadata. New copies must
    # belong to the package account and its Web Station group.
    cp -R "$WEB_ROOT/data/." "$DATA_ROOT/" 2>/dev/null || true
    rm -rf "$WEB_ROOT/data"
fi

chown -R aidrive:http "$DATA_ROOT" 2>/dev/null || true
# Web Station may execute PHP as the http group on some DSM builds. Grant the
# package owner and that group full data access, while denying all other users.
chmod -R u+rwX,g+rwX,o-rwx "$DATA_ROOT"

ln -sfn "$DATA_ROOT" "$WEB_ROOT/data"
chown -R aidrive:http "$WEB_ROOT" 2>/dev/null || true
exit 0
